map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ------------------------------------------------------------
# Upstream Definition (From Canonical)
# Enables keepalive for performance. 
# Assumes your docker service is named 'vaultwarden'
# ------------------------------------------------------------
upstream vaultwarden-backend {
    zone vaultwarden-backend 64k;
    server vaultwarden:80;
    keepalive 2;
}

# ------------------------------------------------------------
# HTTP -> HTTPS Redirect
# ------------------------------------------------------------
server {
    listen 80;
    server_name ${VAULT_SUBDOMAIN};
    return 301 https://$host$request_uri;
}

# ------------------------------------------------------------
# Main SSL Server
# ------------------------------------------------------------
server {
    listen ${SSL_PORT} ssl;
    http2 on; # Enabled HTTP/2
    server_name ${VAULT_SUBDOMAIN};

    # --- Access Control ---
    allow ${PRIVATE_WIREGUARD_ADDRESS};
    deny all;

    # --- SSL Config ---
    ssl_certificate      ${LOCAL_CERT_PATH};
    ssl_certificate_key  ${LOCAL_KEY_PATH};

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # --- Limits ---
    client_max_body_size 525M;

    location / {
        # Points to the upstream block defined at the top
        proxy_pass http://vaultwarden-backend;

        # --- WebSocket & Keepalive Headers (Critical Fix) ---
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # --- Standard Proxy Headers ---
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
