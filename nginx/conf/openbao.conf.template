server {
    listen 80;
    server_name ${OPENBAO_SUBDOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen ${SSL_PORT} ssl;
    server_name ${OPENBAO_SUBDOMAIN};

    allow ${PRIVATE_WIREGUARD_ADDRESS};
    deny all;

    ssl_certificate     ${LOCAL_CERT_PATH};
    ssl_certificate_key ${LOCAL_KEY_PATH};

    proxy_buffering off;

    location / {
        proxy_pass https://openbao:8200;

        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }
}

